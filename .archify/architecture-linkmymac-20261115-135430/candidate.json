  "cards": [
    {
      "dot": "cyan",
      "title": "Transport",
      "items": [
        "TCP 8765, length-framed JSON (LM header)",
        "Wi-Fi via Bonjour _linkmymac._tcp, USB via adb forward",
        "No TLS yet: Wi-Fi traffic is readable on the LAN"
      ]
    },
    {
      "dot": "rose",
      "title": "Pairing & trust",
      "items": [
        "Single-use 6-char code + P-256 ECDH secret",
        "Every connect: HMAC challenge in both directions",
        "Nothing flows until both sides prove the secret"
      ]
    },
    {
      "dot": "emerald",
      "title": "Media & files",
      "items": [
        "Photos and videos page separately, Group by Folder",
        "Play streams byte ranges; seeking cancels ranges",
        "Files stream in 64 KB chunks with backpressure"
      ]
    },
    {
      "dot": "violet",
      "title": "On the Mac",
      "items": [
        "Received files land in ~/Downloads",
        "Clipboard via NSPasteboard, banners via UNUserNotificationCenter"
      ]
    }
  ]
