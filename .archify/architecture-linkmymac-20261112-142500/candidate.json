  "cards": [
    {
      "dot": "cyan",
      "title": "Zero-Cloud Transport & Framing",
      "items": [
        "8-byte length-delimited framing: 0x4C4D ('LM') magic + 2-byte flags + 4-byte big-endian length",
        "Single multiplexed TCP stream on port 8765 handling control, notifications, clipboard, and file chunks",
        "Seamless offline fallback to USB ADB loopback via 'adb forward tcp:8765 tcp:8765'"
      ]
    },
    {
      "dot": "rose",
      "title": "Hardware Security & Out-of-Band Pairing",
      "items": [
        "Hardware-backed EC P-256 keys generated in AndroidKeyStore and Apple Keychain / CryptoKit",
        "Out-of-band QR code exchange of LAN IP addresses, leaf certificate SHA-256 fingerprint, and ephemeral nonce",
        "Mutual TLS (mTLS 1.3) connection strictly pinned to verified leaf certificate fingerprints"
      ]
    },
    {
      "dot": "emerald",
      "title": "Native Subsystem Synchronization",
      "items": [
        "NotificationListenerService intercepts notifications, extracts app icon & RemoteInput quick-reply actions",
        "Bidirectional clipboard synchronization with SHA-256 content deduplication to prevent echo loops",
        "MediaStore photo thumbnail indexing (200x200 WebP) and 64 KB chunked file transfer with CRC32"
      ]
    }
  ]
